<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MultiSessionBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <!-- Android 15 (API 35) enforces edge-to-edge for targetSdk 35 and ignores the
             statusBarColor/navigationBarColor items above, laying the window out BEHIND the
             status bar/cutout - the app never applies WindowInsets, so the header rendered
             under the clock on those devices. Opting out restores the pre-15 fitted layout
             (the attribute is ignored on older devices). Remove this item if edge-to-edge
             with real inset padding is ever implemented instead. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>
</resources>
