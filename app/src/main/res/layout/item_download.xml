<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/dlIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            app:tint="?attr/colorOnSurfaceVariant" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dlName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
            <TextView
                android:id="@+id/dlInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/dlPrimary" style="@style/CompactBarButton" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/more_options" android:src="@drawable/ic_pause" />
        <ImageButton android:id="@+id/dlMore" style="@style/CompactBarButton" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/more_options" android:src="@drawable/ic_more_vert" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/dlProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="1000" />
</LinearLayout>
