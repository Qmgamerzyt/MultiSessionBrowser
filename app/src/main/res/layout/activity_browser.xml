<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1.9: root is GestureDrawerLayout (a DrawerLayout) so a vertical drag is never handed to the
     drawer and a horizontal one still opens it - see ui/browser/GestureDrawerLayout.kt. -->
<app.multisession.browser.ui.browser.GestureDrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:id="@+id/browserRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Invisible default-focus holder (v1.1.2 focus fix): MUST stay the first focusable-in-touch-mode view so
                 framework focus re-assignment never lands on the URL EditText. -->
            <View
                android:id="@+id/focusHolder"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/isolationBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/banner_bg"
                android:padding="10dp"
                android:textColor="@color/banner_text"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Compact app-owned chrome (v2.0.2): row 1 = sessions drawer button + back/forward + session
                 name + new tab + tabs + app menu. All visibility derives from BrowserActivity.applyChrome(). -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer"
                android:orientation="vertical">

                <!-- v2.1.7 (issue E): live download progress inside the app (replaces the transient
                     "Download started" snackbar). Part of the chrome: it hides with the toolbar. -->
                <TextView
                    android:id="@+id/downloadBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/banner_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp"
                    android:textColor="@color/banner_text"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/controlsRow"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <FrameLayout
                        android:id="@+id/sessionsButton"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/sessions"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_menu"
                            app:tint="?attr/colorOnSurface" />
                        <View
                            android:id="@+id/sessionDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_dot" />
                    </FrameLayout>

                    <ImageButton android:id="@+id/backButton" style="@style/CompactBarButton" android:contentDescription="@string/back" android:src="@drawable/ic_arrow_back" />
                    <ImageButton android:id="@+id/forwardButton" style="@style/CompactBarButton" android:contentDescription="@string/forward" android:src="@drawable/ic_arrow_forward" />
                    <!-- v2.1.7: Home navigates the current tab to the configured homepage / start page
                         (never creates a tab, never steals focus - see BrowserActivity). -->
                    <ImageButton android:id="@+id/homeButton" style="@style/CompactBarButton" android:contentDescription="@string/home" android:src="@drawable/ic_home" />
                    <TextView
                        android:id="@+id/sessionName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton android:id="@+id/newTabButton" style="@style/CompactBarButton" android:contentDescription="@string/new_tab" android:src="@drawable/ic_add" />

                    <FrameLayout
                        android:id="@+id/tabsButton"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/tabs"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tabCount"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_tab_count"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <ImageButton android:id="@+id/menuButton" style="@style/CompactBarButton" android:layout_width="44dp" android:contentDescription="@string/menu" android:src="@drawable/ic_menu" />
                </LinearLayout>

                <!-- row 2 = central address / search bar (all v1.1.2 focus + suggestion rules apply to urlInput) -->
                <LinearLayout
                    android:id="@+id/urlBox"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_url_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/securityIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/cd_security"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <EditText
                        android:id="@+id/urlInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/url_hint"
                        android:imeOptions="actionGo|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:selectAllOnFocus="true"
                        android:singleLine="true"
                        android:textSize="15sp" />
                    <ImageButton
                        android:id="@+id/reloadStopButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/reload"
                        android:src="@drawable/ic_refresh"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progressTint="?attr/colorPrimary"
                android:indeterminateTint="?attr/colorPrimary"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <!-- v2.1.7 (H): pull-to-refresh container (pull only when the page is at its top). -->
                <app.multisession.browser.ui.browser.PullRefreshFrameLayout
                    android:id="@+id/webContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <include
                    android:id="@+id/errorPage"
                    layout="@layout/view_error_page"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
                <!-- v2.1.7: the ONLY way out of fullscreen (HTML5 fullscreen and the hidden-toolbar mode).
                     Draggable in both axes; tap to exit. Managed by FullscreenExitButton / applyChrome().
                     v2.1.9: 40dp (was 48dp) and a white cross - it must stay readable over both light
                     and dark pages, so its colour is fixed instead of following the app theme. -->
                <ImageButton
                    android:id="@+id/fullscreenExitButton"
                    style="@style/CompactBarButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_exit_fullscreen"
                    android:contentDescription="@string/fullscreen_exit"
                    android:elevation="6dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@android:color/white" />
            </FrameLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Left: app-owned session drawer -->
    <include
        android:id="@+id/sessionsDrawer"
        layout="@layout/drawer_sessions"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <!-- Right: app-owned browser menu -->
    <include
        android:id="@+id/menuDrawer"
        layout="@layout/drawer_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />
</app.multisession.browser.ui.browser.GestureDrawerLayout>
